# Store text as LF; Windows batch files need CRLF on checkout.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.pdf binary
*.xlsx binary

# Explicit LF for files whose bytes are hashed or replayed (JEV-55): a core.autocrlf=true
# checkout must not be able to write CRLF into these, even though `* text=auto` alone allows it.
*.json text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.gif binary
*.mp4 binary
*.webm binary
