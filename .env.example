# Copy to .env (git-ignored). Only these are read.
TYPESAFE_API_KEY=
# Read by Compose, not by jev_naics.env: compose.yaml forwards this file into the api container, so this
# is where the local stack gets its service keys. Comma-separated; callers send one as
# Authorization: Bearer <key>. Without one the API refuses to start.
# NAICS_API_KEYS=
# NAICS_DATABASE_URL=postgresql://jev:jev@127.0.0.1:5434/jev_naics   (local, outside compose)
